{
  "name": "agent-garden",
  "private": true,
  "type": "module",
  "description": "See every AI agent you run as a living garden: what's thriving, what's wilting, and which one to call.",
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "garden": "tsx --disable-warning=ExperimentalWarning packages/ingest/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
